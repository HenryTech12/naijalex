{
  "manifest_version": 3,
  "name": "NaijaLex — Contract Analyzer",
  "version": "1.0.0",
  "description": "Analyze any Nigerian contract directly from your browser. Get clause breakdowns in English or Lagos Pidgin.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://naijalex.quikdb.net/*", "https://naijalex-frontend.quikdb.net/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://naijalex.quikdb.net/*", "https://naijalex-frontend.quikdb.net/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
